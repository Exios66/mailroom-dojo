{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "Bash(git fetch:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git branch --list:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(python -m pytest tools/governance/tests:*)",
      "Bash(python3 -m pytest tools/governance/tests:*)",
      "Bash(bash -n .circleci/check_no_session_links.sh)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh release:*)",
      "Bash(gh api:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(!.env.example)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force-if-includes:*)",
      "Bash(git push -uf:*)",
      "Bash(git push -fu:*)",
      "Bash(git push +*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * -uf*)",
      "Bash(git push * -fu*)",
      "Bash(git push * +*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git tag -d:*)",
      "Bash(git tag --delete:*)",
      "Bash(git tag -f:*)",
      "Bash(git tag --force:*)",
      "Bash(git tag * -f*)",
      "Bash(git tag * --force*)",
      "Bash(git * --no-gpg-sign*)",
      "Bash(git -c commit.gpgsign=false*)",
      "Bash(git config commit.gpgsign false*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr review:*)",
      "Bash(* --real*)",
      "Bash(* --live*)",
      "Bash(modal deploy:*)",
      "Bash(modal run:*)",
      "Bash(huggingface-cli upload:*)",
      "Bash(hf upload:*)",
      "Bash(langfuse *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_session_links.py\""
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_session_links.py\""
          }
        ]
      }
    ]
  }
}
