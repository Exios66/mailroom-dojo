{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git branch --list:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(python -m pytest tools/governance/tests:*)",
      "Bash(python3 -m pytest tools/governance/tests:*)",
      "Bash(PYTHONDONTWRITEBYTECODE=1 python -m pytest tools/governance/tests:*)",
      "Bash(PYTHONDONTWRITEBYTECODE=1 python3 -m pytest tools/governance/tests:*)",
      "Bash(bash -n .circleci/check_no_session_links.sh)",
      "Bash(bash .circleci/check_no_session_links.sh)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh release:*)",
      "Bash(gh api:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "Bash(* --real*)",
      "Bash(* --live*)",
      "mcp__github__issue_write",
      "mcp__plugin_engineering_github__merge_pull_request",
      "mcp__plugin_engineering_github__enable_pr_auto_merge",
      "mcp__plugin_engineering_github__push_files",
      "mcp__plugin_engineering_github__create_or_update_file",
      "mcp__plugin_engineering_github__delete_file",
      "mcp__plugin_engineering_github__issue_write"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.test)",
      "Read(./**/.env.test)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force-if-includes:*)",
      "Bash(git push -uf:*)",
      "Bash(git push -fu:*)",
      "Bash(git push +*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * -uf*)",
      "Bash(git push * -fu*)",
      "Bash(git push * +*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push --delete:*)",
      "Bash(git push -d:*)",
      "Bash(git push * :*)",
      "Bash(git push --mirror:*)",
      "Bash(git push * --mirror*)",
      "Bash(git tag -d:*)",
      "Bash(git tag --delete:*)",
      "Bash(git tag -f:*)",
      "Bash(git tag --force:*)",
      "Bash(git tag * -f*)",
      "Bash(git tag * --force*)",
      "Bash(git * --no-gpg-sign*)",
      "Bash(git -c commit.gpgsign=false*)",
      "Bash(git config commit.gpgsign false*)",
      "Bash(git -c commit.gpgsign=*)",
      "Bash(git * -c commit.gpgsign=*)",
      "Bash(git config commit.gpgsign *)",
      "Bash(git config * commit.gpgsign *)",
      "Bash(git -c commit.gpgSign=*)",
      "Bash(git * -c commit.gpgSign=*)",
      "Bash(git config commit.gpgSign *)",
      "Bash(git config * commit.gpgSign *)",
      "Bash(git -c commit.GPGSIGN=*)",
      "Bash(git * -c commit.GPGSIGN=*)",
      "Bash(git config commit.GPGSIGN *)",
      "Bash(git config * commit.GPGSIGN *)",
      "Bash(git -c tag.gpgsign=*)",
      "Bash(git * -c tag.gpgsign=*)",
      "Bash(git config tag.gpgsign *)",
      "Bash(git config * tag.gpgsign *)",
      "Bash(git -c tag.gpgSign=*)",
      "Bash(git * -c tag.gpgSign=*)",
      "Bash(git config tag.gpgSign *)",
      "Bash(git config * tag.gpgSign *)",
      "Bash(git -c tag.GPGSIGN=*)",
      "Bash(git * -c tag.GPGSIGN=*)",
      "Bash(git config tag.GPGSIGN *)",
      "Bash(git config * tag.GPGSIGN *)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr review:*)",
      "Bash(modal deploy:*)",
      "Bash(modal run:*)",
      "Bash(huggingface-cli upload:*)",
      "Bash(hf upload:*)",
      "Bash(langfuse *)",
      "Bash(git grep*-O*)",
      "Bash(git grep*--open-files-in-pager*)",
      "Bash(git diff*--output*)",
      "Bash(git log*--output*)",
      "Bash(git show*--output*)",
      "Bash(git diff*--no-index*)",
      "Bash(git * --upload-pack*)",
      "mcp__github__add_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__pull_request_review_write",
      "mcp__github__update_issue_comment",
      "mcp__plugin_engineering_github__add_issue_comment",
      "mcp__plugin_engineering_github__add_reply_to_pull_request_comment",
      "mcp__plugin_engineering_github__add_comment_to_pending_review",
      "mcp__plugin_engineering_github__pull_request_review_write",
      "mcp__plugin_engineering_github__update_issue_comment"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|NotebookEdit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_session_links.py\""
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__.*[Gg][Ii][Tt][Hh][Uu][Bb].*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_session_links.py\""
          }
        ]
      }
    ]
  }
}
